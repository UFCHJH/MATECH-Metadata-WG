        OPTIONAL {
          ?v38 ns8:addressArea ?v45 .
        }
        OPTIONAL {
          ?v38 ns8:postName ?v46 .
        }
        OPTIONAL {
          ?v38 ns8:adminUnitL2 ?v47 .
        }
        OPTIONAL {
          ?v38 ns8:adminUnitL1 ?v48 .
        }
        OPTIONAL {
          ?v38 ns8:postCode ?v49 .
        }
      }
    }
    OPTIONAL {
      ?v26 ns0:hasAffiliation ?v50 .
      OPTIONAL {
        ?v50 a ns5:Agent .
      }
    }
  } UNION {
    ?v0 ns4:relation ?v51 .
    ?v51 a ns5:Agent .
