WHERE {
  ?v0 a ns0:ResourceToAgentRelationship .
  ?v0 ns1:hadRole ?v1 .
  OPTIONAL {
    ?v1 a ns2:Concept .
  }
  OPTIONAL {
    ?v1 ns3:label ?v2 .
  }
  {
    ?v0 ns4:relation ?v3 .
    ?v3 a ns5:Agent .
    ?v3 ns5:name ?v4 .
    OPTIONAL {
      ?v3 ns6:organization-name ?v5 .
