PREFIX ns8: <http://www.w3.org/ns/locn#>
PREFIX ns9: <http://www.w3.org/ns/prov#>
CONSTRUCT {
  ?v0 a ns0:ResourceToAgentRelationship .
  ?v0 ns1:hadRole ?v1 .
  ?v1 a ns2:Concept .
  ?v1 ns3:label ?v2 .
  ?v0 ns4:relation ?v3 .
  ?v3 a ns5:Agent .
  ?v3 ns5:name ?v4 .
  ?v3 ns6:organization-name ?v5 .
  ?v3 ns0:hasIdentifier ?v6 .
