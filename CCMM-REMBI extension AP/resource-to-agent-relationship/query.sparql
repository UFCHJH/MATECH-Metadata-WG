        OPTIONAL {
          ?v14 ns8:addressArea ?v21 .
        }
        OPTIONAL {
          ?v14 ns8:postName ?v22 .
        }
        OPTIONAL {
          ?v14 ns8:adminUnitL2 ?v23 .
        }
        OPTIONAL {
          ?v14 ns8:adminUnitL1 ?v24 .
        }
        OPTIONAL {
          ?v14 ns8:postCode ?v25 .
        }
      }
    }
  } UNION {
    ?v0 ns4:relation ?v26 .
    ?v26 a ns9:Person .
    ?v26 ns5:name ?v27 .
    OPTIONAL {
      ?v26 ns6:given-name ?v28 .
    }
    OPTIONAL {
      ?v26 ns6:family-name ?v29 .
    }
    OPTIONAL {
      ?v26 ns0:hasIdentifier ?v30 .
      OPTIONAL {
        ?v30 a ns7:Identifier .
