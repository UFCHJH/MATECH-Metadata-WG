    OPTIONAL {
      ?v26 ns1:contactPoint ?v34 .
      OPTIONAL {
        ?v34 a ns0:ContactDetails .
      }
      OPTIONAL {
        ?v34 ns0:dataBox ?v35 .
      }
      OPTIONAL {
        ?v34 ns0:email ?v36 .
      }
      OPTIONAL {
        ?v34 ns0:phone ?v37 .
      }
      OPTIONAL {
        ?v34 ns6:hasAddress ?v38 .
