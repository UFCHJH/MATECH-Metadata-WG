PREFIX ns0: <https://model.ccmm.cz/vocabulary/datacite#>
PREFIX ns1: <https://model.ccmm.cz/vocabulary/ccmm#>
PREFIX ns2: <http://xmlns.com/foaf/0.1/>
PREFIX ns3: <http://www.w3.org/2006/vcard/ns#>
PREFIX ns4: <http://www.w3.org/ns/adms#>
PREFIX ns5: <http://www.w3.org/2004/02/skos/core#>
PREFIX ns6: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ns7: <http://www.w3.org/ns/dcat#>
PREFIX ns8: <http://www.w3.org/ns/locn#>
PREFIX ns9: <http://www.w3.org/ns/prov#>
CONSTRUCT {
  ?v0 a ns0:FundingReference .
  ?v0 ns1:fundingProgram ?v1 .
  ?v0 ns0:awardTitle ?v2 .
  ?v0 ns0:awardNumber ?v3 .
  ?v0 ns0:hasFunderIdentifier ?v4 .
  ?v4 a ns2:Agent .
  ?v4 ns2:name ?v5 .
  ?v4 ns3:organization-name ?v6 .
  ?v4 ns1:hasIdentifier ?v7 .
  ?v7 a ns4:Identifier .
  ?v7 ns5:notation ?v8 .
  ?v7 ns1:inScheme ?v9 .
  ?v9 a ns1:IdentifierScheme .
  ?v9 ns6:label ?v10 .
  ?v4 ns7:contactPoint ?v11 .
  ?v11 a ns1:ContactDetails .
  ?v11 ns1:dataBox ?v12 .
  ?v11 ns1:email ?v13 .
  ?v11 ns1:phone ?v14 .
  ?v11 ns3:hasAddress ?v15 .
  ?v15 a ns8:Address .
  ?v15 ns6:label ?v16 .
  ?v15 ns8:fullAddress ?v17 .
  ?v15 ns8:poBox ?v18 .
  ?v15 ns8:thoroughfare ?v19 .
  ?v15 ns8:locatorDesignator ?v20 .
  ?v15 ns8:locatorName ?v21 .
  ?v15 ns8:addressArea ?v22 .
  ?v15 ns8:postName ?v23 .
  ?v15 ns8:adminUnitL2 ?v24 .
  ?v15 ns8:adminUnitL1 ?v25 .
  ?v15 ns8:postCode ?v26 .
  ?v0 ns0:hasFunderIdentifier ?v27 .
  ?v27 a ns9:Person .
  ?v27 ns2:name ?v28 .
  ?v27 ns3:given-name ?v29 .
  ?v27 ns3:family-name ?v30 .
  ?v27 ns1:hasIdentifier ?v31 .
  ?v31 a ns4:Identifier .
  ?v31 ns5:notation ?v32 .
  ?v31 ns1:inScheme ?v33 .
  ?v33 a ns1:IdentifierScheme .
  ?v33 ns6:label ?v34 .
  ?v27 ns7:contactPoint ?v35 .
  ?v35 a ns1:ContactDetails .
  ?v35 ns1:dataBox ?v36 .
  ?v35 ns1:email ?v37 .
  ?v35 ns1:phone ?v38 .
  ?v35 ns3:hasAddress ?v39 .
  ?v39 a ns8:Address .
  ?v39 ns6:label ?v40 .
  ?v39 ns8:fullAddress ?v41 .
  ?v39 ns8:poBox ?v42 .
  ?v39 ns8:thoroughfare ?v43 .
  ?v39 ns8:locatorDesignator ?v44 .
  ?v39 ns8:locatorName ?v45 .
  ?v39 ns8:addressArea ?v46 .
  ?v39 ns8:postName ?v47 .
  ?v39 ns8:adminUnitL2 ?v48 .
  ?v39 ns8:adminUnitL1 ?v49 .
  ?v39 ns8:postCode ?v50 .
  ?v27 ns1:hasAffiliation ?v51 .
  ?v51 a ns2:Agent .
  ?v0 ns0:hasFunderIdentifier ?v52 .
  ?v52 a ns2:Agent .
}
WHERE {
  ?v0 a ns0:FundingReference .
  OPTIONAL {
    ?v0 ns1:fundingProgram ?v1 .
  }
  OPTIONAL {
    ?v0 ns0:awardTitle ?v2 .
  }
  OPTIONAL {
    ?v0 ns0:awardNumber ?v3 .
  }
  {
    ?v0 ns0:hasFunderIdentifier ?v4 .
    ?v4 a ns2:Agent .
    ?v4 ns2:name ?v5 .
    OPTIONAL {
      ?v4 ns3:organization-name ?v6 .
    }
    OPTIONAL {
      ?v4 ns1:hasIdentifier ?v7 .
      OPTIONAL {
        ?v7 a ns4:Identifier .
      }
      ?v7 ns5:notation ?v8 .
      ?v7 ns1:inScheme ?v9 .
      OPTIONAL {
        ?v9 a ns1:IdentifierScheme .
      }
      OPTIONAL {
        ?v9 ns6:label ?v10 .
      }
    }
    OPTIONAL {
      ?v4 ns7:contactPoint ?v11 .
      OPTIONAL {
        ?v11 a ns1:ContactDetails .
      }
      OPTIONAL {
        ?v11 ns1:dataBox ?v12 .
      }
      OPTIONAL {
        ?v11 ns1:email ?v13 .
      }
      OPTIONAL {
        ?v11 ns1:phone ?v14 .
      }
      OPTIONAL {
        ?v11 ns3:hasAddress ?v15 .
        OPTIONAL {
          ?v15 a ns8:Address .
        }
        OPTIONAL {
          ?v15 ns6:label ?v16 .
        }
        OPTIONAL {
          ?v15 ns8:fullAddress ?v17 .
        }
        OPTIONAL {
          ?v15 ns8:poBox ?v18 .
        }
        OPTIONAL {
          ?v15 ns8:thoroughfare ?v19 .
        }
        OPTIONAL {
          ?v15 ns8:locatorDesignator ?v20 .
        }
        OPTIONAL {
          ?v15 ns8:locatorName ?v21 .
        }
        OPTIONAL {
          ?v15 ns8:addressArea ?v22 .
        }
        OPTIONAL {
          ?v15 ns8:postName ?v23 .
        }
        OPTIONAL {
          ?v15 ns8:adminUnitL2 ?v24 .
        }
        OPTIONAL {
          ?v15 ns8:adminUnitL1 ?v25 .
        }
        OPTIONAL {
          ?v15 ns8:postCode ?v26 .
        }
      }
    }
  } UNION {
    ?v0 ns0:hasFunderIdentifier ?v27 .
    ?v27 a ns9:Person .
    ?v27 ns2:name ?v28 .
    OPTIONAL {
      ?v27 ns3:given-name ?v29 .
    }
    OPTIONAL {
      ?v27 ns3:family-name ?v30 .
    }
    OPTIONAL {
      ?v27 ns1:hasIdentifier ?v31 .
      OPTIONAL {
        ?v31 a ns4:Identifier .
      }
      ?v31 ns5:notation ?v32 .
      ?v31 ns1:inScheme ?v33 .
      OPTIONAL {
        ?v33 a ns1:IdentifierScheme .
      }
      OPTIONAL {
        ?v33 ns6:label ?v34 .
      }
    }
    OPTIONAL {
      ?v27 ns7:contactPoint ?v35 .
      OPTIONAL {
        ?v35 a ns1:ContactDetails .
      }
      OPTIONAL {
        ?v35 ns1:dataBox ?v36 .
      }
      OPTIONAL {
        ?v35 ns1:email ?v37 .
      }
      OPTIONAL {
        ?v35 ns1:phone ?v38 .
      }
      OPTIONAL {
        ?v35 ns3:hasAddress ?v39 .
        OPTIONAL {
          ?v39 a ns8:Address .
        }
        OPTIONAL {
          ?v39 ns6:label ?v40 .
        }
        OPTIONAL {
          ?v39 ns8:fullAddress ?v41 .
        }
        OPTIONAL {
          ?v39 ns8:poBox ?v42 .
        }
        OPTIONAL {
          ?v39 ns8:thoroughfare ?v43 .
        }
        OPTIONAL {
          ?v39 ns8:locatorDesignator ?v44 .
        }
        OPTIONAL {
          ?v39 ns8:locatorName ?v45 .
        }
        OPTIONAL {
          ?v39 ns8:addressArea ?v46 .
        }
        OPTIONAL {
          ?v39 ns8:postName ?v47 .
        }
        OPTIONAL {
          ?v39 ns8:adminUnitL2 ?v48 .
        }
        OPTIONAL {
          ?v39 ns8:adminUnitL1 ?v49 .
        }
        OPTIONAL {
          ?v39 ns8:postCode ?v50 .
        }
      }
    }
    OPTIONAL {
      ?v27 ns1:hasAffiliation ?v51 .
      OPTIONAL {
        ?v51 a ns2:Agent .
      }
    }
  } UNION {
    ?v0 ns0:hasFunderIdentifier ?v52 .
    ?v52 a ns2:Agent .
  }
}
