<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" vc:minVersion="1.1" elementFormDefault="unqualified" xmlns:xml="http://www.w3.org/XML/1998/namespace" xmlns:sawsdl="http://www.w3.org/ns/sawsdl">
  <xs:complexType name="type">
    <xs:choice>
      <xs:element name="methods_and_tools">
        <xs:complexType sawsdl:modelReference="http://www.w3.org/2004/02/skos/core#Concept">
          <xs:annotation>
            <xs:documentation xml:lang="en">
              Methods and Tools - An abstract class unifiing methods and tools.
            </xs:documentation>
          </xs:annotation>
          <xs:sequence>
            <xs:element name="iri" type="xs:anyURI"/>
            <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="methode">
        <xs:complexType sawsdl:modelReference="http://w3id.org/nfdi4ing/metadata4ing#Method">
          <xs:annotation>
            <xs:documentation xml:lang="de">
              Methode
            </xs:documentation>
            <xs:documentation xml:lang="en">
              Method - Abstract description of a method for analysis, generation and transformation of samples and data.
            </xs:documentation>
          </xs:annotation>
          <xs:sequence>
            <xs:element name="iri" type="xs:anyURI"/>
            <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="werkzeug">
        <xs:complexType sawsdl:modelReference="http://w3id.org/nfdi4ing/metadata4ing#Tool">
          <xs:annotation>
            <xs:documentation xml:lang="de">
              Werkzeug
            </xs:documentation>
            <xs:documentation xml:lang="en">
              Tool - Object that helps an agent to perform an action. e.g., confocal microscope / imageJ software
            </xs:documentation>
          </xs:annotation>
          <xs:sequence>
            <xs:element name="iri" type="xs:anyURI"/>
            <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:complexType>
  <xs:element name="element" type="type"/>
</xs:schema>
