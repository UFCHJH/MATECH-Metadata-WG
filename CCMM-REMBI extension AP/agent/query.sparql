PREFIX ns0: <http://xmlns.com/foaf/0.1/>
PREFIX ns1: <http://www.w3.org/2006/vcard/ns#>
PREFIX ns2: <https://model.ccmm.cz/vocabulary/ccmm#>
PREFIX ns3: <http://www.w3.org/ns/adms#>
PREFIX ns4: <http://www.w3.org/2004/02/skos/core#>
PREFIX ns5: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ns6: <http://www.w3.org/ns/dcat#>
PREFIX ns7: <http://www.w3.org/ns/locn#>
PREFIX ns8: <http://www.w3.org/ns/prov#>
CONSTRUCT {
  ?v0 a ns0:Agent .
  ?v0 ns0:name ?v1 .
  ?v0 ns1:organization-name ?v2 .
  ?v0 ns2:hasIdentifier ?v3 .
  ?v3 a ns3:Identifier .
  ?v3 ns4:notation ?v4 .
  ?v3 ns2:inScheme ?v5 .
  ?v5 a ns2:IdentifierScheme .
  ?v5 ns5:label ?v6 .
  ?v0 ns6:contactPoint ?v7 .
  ?v7 a ns2:ContactDetails .
  ?v7 ns2:dataBox ?v8 .
  ?v7 ns2:email ?v9 .
  ?v7 ns2:phone ?v10 .
  ?v7 ns1:hasAddress ?v11 .
  ?v11 a ns7:Address .
  ?v11 ns5:label ?v12 .
  ?v11 ns7:fullAddress ?v13 .
  ?v11 ns7:poBox ?v14 .
  ?v11 ns7:thoroughfare ?v15 .
  ?v11 ns7:locatorDesignator ?v16 .
  ?v11 ns7:locatorName ?v17 .
  ?v11 ns7:addressArea ?v18 .
  ?v11 ns7:postName ?v19 .
  ?v11 ns7:adminUnitL2 ?v20 .
  ?v11 ns7:adminUnitL1 ?v21 .
  ?v11 ns7:postCode ?v22 .
  ?v23 a ns8:Person .
  ?v23 ns0:name ?v24 .
  ?v23 ns1:given-name ?v25 .
  ?v23 ns1:family-name ?v26 .
  ?v23 ns2:hasIdentifier ?v27 .
  ?v27 a ns3:Identifier .
  ?v27 ns4:notation ?v28 .
  ?v27 ns2:inScheme ?v29 .
  ?v29 a ns2:IdentifierScheme .
  ?v29 ns5:label ?v30 .
  ?v23 ns6:contactPoint ?v31 .
  ?v31 a ns2:ContactDetails .
  ?v31 ns2:dataBox ?v32 .
  ?v31 ns2:email ?v33 .
  ?v31 ns2:phone ?v34 .
  ?v31 ns1:hasAddress ?v35 .
  ?v35 a ns7:Address .
  ?v35 ns5:label ?v36 .
  ?v35 ns7:fullAddress ?v37 .
  ?v35 ns7:poBox ?v38 .
  ?v35 ns7:thoroughfare ?v39 .
  ?v35 ns7:locatorDesignator ?v40 .
  ?v35 ns7:locatorName ?v41 .
  ?v35 ns7:addressArea ?v42 .
  ?v35 ns7:postName ?v43 .
  ?v35 ns7:adminUnitL2 ?v44 .
  ?v35 ns7:adminUnitL1 ?v45 .
  ?v35 ns7:postCode ?v46 .
  ?v23 ns2:hasAffiliation ?v47 .
  ?v47 a ns0:Agent .
  ?v48 a ns0:Agent .
}
WHERE {
  {
    ?v0 a ns0:Agent .
    ?v0 ns0:name ?v1 .
    OPTIONAL {
      ?v0 ns1:organization-name ?v2 .
    }
    OPTIONAL {
      ?v0 ns2:hasIdentifier ?v3 .
      OPTIONAL {
        ?v3 a ns3:Identifier .
      }
      ?v3 ns4:notation ?v4 .
      ?v3 ns2:inScheme ?v5 .
      OPTIONAL {
        ?v5 a ns2:IdentifierScheme .
      }
      OPTIONAL {
        ?v5 ns5:label ?v6 .
      }
    }
    OPTIONAL {
      ?v0 ns6:contactPoint ?v7 .
      OPTIONAL {
        ?v7 a ns2:ContactDetails .
      }
      OPTIONAL {
        ?v7 ns2:dataBox ?v8 .
      }
      OPTIONAL {
        ?v7 ns2:email ?v9 .
      }
      OPTIONAL {
        ?v7 ns2:phone ?v10 .
      }
      OPTIONAL {
        ?v7 ns1:hasAddress ?v11 .
        OPTIONAL {
          ?v11 a ns7:Address .
        }
        OPTIONAL {
          ?v11 ns5:label ?v12 .
        }
        OPTIONAL {
          ?v11 ns7:fullAddress ?v13 .
        }
        OPTIONAL {
          ?v11 ns7:poBox ?v14 .
        }
        OPTIONAL {
          ?v11 ns7:thoroughfare ?v15 .
        }
        OPTIONAL {
          ?v11 ns7:locatorDesignator ?v16 .
        }
        OPTIONAL {
          ?v11 ns7:locatorName ?v17 .
        }
        OPTIONAL {
          ?v11 ns7:addressArea ?v18 .
        }
        OPTIONAL {
          ?v11 ns7:postName ?v19 .
        }
        OPTIONAL {
          ?v11 ns7:adminUnitL2 ?v20 .
        }
        OPTIONAL {
          ?v11 ns7:adminUnitL1 ?v21 .
        }
        OPTIONAL {
          ?v11 ns7:postCode ?v22 .
        }
      }
    }
  } UNION {
    ?v23 a ns8:Person .
    ?v23 ns0:name ?v24 .
    OPTIONAL {
      ?v23 ns1:given-name ?v25 .
    }
    OPTIONAL {
      ?v23 ns1:family-name ?v26 .
    }
    OPTIONAL {
      ?v23 ns2:hasIdentifier ?v27 .
      OPTIONAL {
        ?v27 a ns3:Identifier .
      }
      ?v27 ns4:notation ?v28 .
      ?v27 ns2:inScheme ?v29 .
      OPTIONAL {
        ?v29 a ns2:IdentifierScheme .
      }
      OPTIONAL {
        ?v29 ns5:label ?v30 .
      }
    }
    OPTIONAL {
      ?v23 ns6:contactPoint ?v31 .
      OPTIONAL {
        ?v31 a ns2:ContactDetails .
      }
      OPTIONAL {
        ?v31 ns2:dataBox ?v32 .
      }
      OPTIONAL {
        ?v31 ns2:email ?v33 .
      }
      OPTIONAL {
        ?v31 ns2:phone ?v34 .
      }
      OPTIONAL {
        ?v31 ns1:hasAddress ?v35 .
        OPTIONAL {
          ?v35 a ns7:Address .
        }
        OPTIONAL {
          ?v35 ns5:label ?v36 .
        }
        OPTIONAL {
          ?v35 ns7:fullAddress ?v37 .
        }
        OPTIONAL {
          ?v35 ns7:poBox ?v38 .
        }
        OPTIONAL {
          ?v35 ns7:thoroughfare ?v39 .
        }
        OPTIONAL {
          ?v35 ns7:locatorDesignator ?v40 .
        }
        OPTIONAL {
          ?v35 ns7:locatorName ?v41 .
        }
        OPTIONAL {
          ?v35 ns7:addressArea ?v42 .
        }
        OPTIONAL {
          ?v35 ns7:postName ?v43 .
        }
        OPTIONAL {
          ?v35 ns7:adminUnitL2 ?v44 .
        }
        OPTIONAL {
          ?v35 ns7:adminUnitL1 ?v45 .
        }
        OPTIONAL {
          ?v35 ns7:postCode ?v46 .
        }
      }
    }
    OPTIONAL {
      ?v23 ns2:hasAffiliation ?v47 .
      OPTIONAL {
        ?v47 a ns0:Agent .
      }
    }
  } UNION {
    ?v48 a ns0:Agent .
  }
}
