:ImageCorrelation dct:isPartOf <https://example.com/profile/vocabulary#>;
    a dsv:TermProfile;
    skos:prefLabel "Arbeitsschritt"@de, "Image Correlation"@en;
    skos:definition "A specific ProcessingStep focused on comparing and mapping information between two or more images, either from different modalities, time points, or perspectives"@en;
    dsv:specializes :ImageAnalysis, :ImageAnalysis;
    a dsv:ClassProfile;
    dsv:class <http://w3id.org/nfdi4ing/metadata4ing#ProcessingStep>.
:ImageAnalysis dct:isPartOf <https://example.com/profile/vocabulary#>;
    a dsv:TermProfile;
    skos:prefLabel "Arbeitsschritt"@de, "Image Analysis"@en;
    skos:definition "A specific ProcessingStep describing process of quantitative or qualitative evaluation of image data."@en;
    dsv:specializes :ProcessingStep;
    a dsv:ClassProfile;
    dsv:class <http://w3id.org/nfdi4ing/metadata4ing#ProcessingStep>.
:MethodsAndTools dct:isPartOf <https://example.com/profile/vocabulary#>;
    a dsv:TermProfile;
    skos:prefLabel "Methods and Tools"@en;
    skos:definition "An abstract class unifiing methods and tools."@en;
    a dsv:ClassProfile;
    dsv:class skos:Concept.
:ImageAcquisition dct:isPartOf <https://example.com/profile/vocabulary#>;
    a dsv:TermProfile;
    skos:prefLabel "Arbeitsschritt"@de, "Image Acquisition"@en;
    skos:definition "A specific ProcessingStep describing the process of capturing image data from Sample using an imaging device and method."@en;
    dsv:specializes :ProcessingStep;
    a dsv:ClassProfile;
    dsv:class <http://w3id.org/nfdi4ing/metadata4ing#ProcessingStep>.
:SamplePreparation dct:isPartOf <https://example.com/profile/vocabulary#>;
    a dsv:TermProfile;
    skos:prefLabel "Arbeitsschritt"@de, "Sample Preparation"@en;
    skos:definition "A specific ProcessingStep encompassing all physical, chemical, or biological manipulations applied to a sample before its imaging."@en;
    dsv:specializes :ProcessingStep;
    a dsv:ClassProfile;
    dsv:class <http://w3id.org/nfdi4ing/metadata4ing#ProcessingStep>.
:GrowthProtocol dct:isPartOf <https://example.com/profile/vocabulary#>;
    a dsv:TermProfile;
    skos:prefLabel "Arbeitsschritt"@de, "Growth Protocol"@en;
    skos:definition "A specific ProcessingStep describing growing  and/or cultivation of biological samples. It describes the sample's development before its subsequent sample preparation including treatments applied its growth and cultivation."@en;
    dsv:specializes :ProcessingStep;
    a dsv:ClassProfile;
    dsv:class <http://w3id.org/nfdi4ing/metadata4ing#ProcessingStep>.
:ImageProcessing dct:isPartOf <https://example.com/profile/vocabulary#>;
    a dsv:TermProfile;
    skos:prefLabel "Arbeitsschritt"@de, "Image Processing"@en;
    skos:definition "A specific ProcessingStep Involves application of computational techniques to image data (usually raw) prior to its subsequent data analysis or interpretation and/or long-term preservation. "@en;
    dsv:specializes :ProcessingStep;
    a dsv:ClassProfile;
    dsv:class <http://w3id.org/nfdi4ing/metadata4ing#ProcessingStep>.

